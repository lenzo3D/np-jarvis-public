# The setup wizard in the control panel creates secrets.env for you; you rarely need to edit it by hand.
# Copy to secrets.env (chmod 600) only if you prefer to configure by hand. Never commit secrets.env.
# Your name, and how JARVIS addresses you (Sir, Ma'am, boss, or your name)
USER_NAME=
ADDRESS_AS=Sir
ALLOWED_TELEGRAM_ID=123456789
OPS_BOT_TOKEN=
POLITEMALL_BASE=https://politemall.polite.edu.sg
POLITEMALL_USER=
POLITEMALL_PASS=
# Telethon (my.telegram.org -> API development tools)
TELETHON_API_ID=
TELETHON_API_HASH=
# Comma-separated Telegram group chat ids to watch
GROUP_CHAT_IDS=
# Only true on the deployed server
ACTIONS_ENABLED=false
# Optional overrides
# Which courses to watch: empty = newest semester (e.g. 26S2), * = all, or a code prefix
# COURSE_PREFIX=
# Monday of semester week 1 (YYYY-MM-DD) so "Week 9" in teaching plans becomes a date
# SEMESTER_START=
# STATE_DIR=./state
# WORKSPACE_DIR=./workspace
# OPS_SOCKET=./state/ops.sock
